#: src/data/profile.ts:224
msgid ""
"A startup founded with university friends providing web development and "
"hosting to local companies, with clients across gaming, construction and "
"local government."
msgstr ""
"Una startup fundada con amigos de la universidad que ofrecía desarrollo web "
"y hosting a empresas locales, con clientes en los rubros de juegos, "
"construcción y gobierno local."

#: src/data/profile.ts:130
msgid "Agile delivery & refinement"
msgstr "Entrega ágil y refinamiento"

#: src/ProfilePage.vue:27
